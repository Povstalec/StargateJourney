        "argument": {
          "type": "minecraft:blend_density",
          "argument": {
            "type": "minecraft:add",
            "argument1": {
              "type": "minecraft:y_clamped_gradient",
              "from_y": 0,
              "to_y": 228,
              "from_value": 1,
              "to_value": -1
            },
            "argument2": {
              "type": "minecraft:noise",
              "noise": "minecraft:erosion",
              "xz_scale": 1,
              "y_scale": 0
            }
          }
        }
      }
    },
    "fluid_level_floodedness": 1,
